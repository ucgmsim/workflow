Bootstrap: docker
From: earthquakesuc/workflow-bootstrap:latest

# Visualisation container (figures + animations): plot-srf, plot-ts, etc.
# Built on top of the simulation base image so it reuses the whole verified
# scientific stack (pygmt, pygmt_helper, cartopy, matplotlib, source_modelling,
# workflow, qcore) without pulling any of it in again. Deliberately does NOT
# include EMOD3D — this image only makes plots, it does not simulate.
#
# It DOES carry a working `generate-stoch`, which is not a visualisation tool.
# That is deliberate: runner.sif ships the clamped, C-binary implementation that
# cannot produce a stoch at a requested dx/dy (see %post), and runner.sif drives
# the live production workflow, so rebuilding it to fix that is the higher-risk
# change. This image is a side tool, so the capability lands here.
#
# BUILD (must run from the repo root — %files paths are relative to $PWD):
#     container/build_viz.sh
# It exports the current branch to container/workflow-src.tar.gz and stamps the
# version, both of which %files below expects. Do not call `apptainer build`
# directly unless you have created those two files yourself.

%files
    # The workflow source to install over the base image's copy, exported from
    # the working tree by build_viz.sh. A tarball rather than a git URL so the
    # image can be built from an unpushed branch; switch to a pinned
    # `git+https://...@<sha>` once cs-nshm2022-prep is published, the way the
    # visualisation install below is pinned.
    container/workflow-src.tar.gz /tmp/workflow-src.tar.gz
    container/workflow-version.txt /tmp/workflow-version.txt

%post
    set -e

    # System libraries: GMT (libgmt for pygmt) + coastline/border data, the
    # ffmpeg binary (matplotlib FFMpegWriter + plot_ts's shutil.which("ffmpeg")),
    # ghostscript (pygmt's psconvert shells out to `gs` to rasterise figures
    # to PNG/PDF; the gmt package does NOT pull it in, so savefig fails without it),
    # and R (r-base-dev) so rpy2 can build against it and load it at runtime.
    # visualisation/utils.py imports rpy2 at module level for its LOESS helper
    # (utils.fit_loess_r), so WITHOUT R every tool that imports utils -- plot-srf
    # and plot-ts included -- dies at import, even though only the gmm/alpine
    # plots actually call into R. r-base-dev (not r-base-core) because rpy2 builds
    # a C extension against R's headers; gcc/make are already in the base image.
    #
    # xvfb + mesa software GL (libgl1 / libglx-mesa0 / libgl1-mesa-dri) + the X
    # libs VTK links against: plot_ts's xyts / xyts-diff subcommands render
    # off-screen 3D through pyvista (VTK). VTK needs a live OpenGL context even
    # for off_screen=True, and the batch nodes have no GPU and no X server -- so
    # those subcommands run under `xvfb-run -a` and mesa's llvmpipe does the
    # rendering in software. (vtk-osmesa would avoid xvfb, but it publishes no
    # cp313 wheels, so xvfb is the route for this image's Python 3.13. The srf
    # animation and plot-srf do NOT need any of this.)
    apt-get update && apt-get install -y \
        gmt gmt-gshhg gmt-dcw ffmpeg ghostscript \
        r-base-dev \
        xvfb libgl1 libglx-mesa0 libgl1-mesa-dri \
        libxrender1 libxext6 libsm6 libxt6 \
     && rm -rf /var/lib/apt/lists/*

    # The `gmt` package ships only the versioned libgmt.so.6 (the unversioned
    # symlink lives in libgmt-dev, which we don't want at runtime). pygmt dlopens
    # the *unversioned* "libgmt.so" and GMT_LIBRARY_PATH does not change that, so
    # create the symlink ourselves. Must happen before anything imports pygmt.
    ln -sf "$(find /usr/lib -maxdepth 2 -name 'libgmt.so.*' | sort | head -1)" \
        /usr/lib/x86_64-linux-gnu/libgmt.so
    ldconfig

    # visualisation's requirements.txt cannot resolve cleanly: it lists
    # `qcore @ git` (that repo's real package name is qcore-utils, already
    # present) and `source_modelling @ git` with no floor (would clobber the
    # pinned 2026.7.2 with a git-HEAD build). So install --no-deps against the
    # base image's stack, adding the genuinely-missing runtime deps explicitly:
    # ffmpeg-python (imported by visualisation/plot_ts.py), rpy2 (imported at
    # module level by visualisation/utils.py; needs the R installed above), and
    # pyvista + vtk + imageio(-ffmpeg) for plot_ts's xyts / xyts-diff off-screen
    # 3D movie rendering (pv.Plotter(off_screen=True) + plotter.open_movie). vtk
    # 9.6.2 is the regular GLX wheel, run headless via xvfb (above). Versions are
    # pinned to the dev .venv / a validated resolve; installed WITHOUT --no-deps
    # so their own deps (cffi, scooby, imageio-ffmpeg, ...) come along. --no-deps
    # is only for the visualisation install below.
    #
    # Pinned to the exact commit that carries the plot-srf fix (skip
    # near-vertical planes + restored pre-drift basemap/slip style). The bare
    # repo URL resolves to master, which predates the fix, so pin the commit
    # for a reproducible build. Bump this SHA -- or drop back to the bare URL --
    # once cs-nshm-2022-prep merges to master.
    /sw/venv/bin/pip install --no-cache-dir ffmpeg-python "rpy2==3.6.7" \
        "pyvista==0.48.4" "vtk==9.6.2" imageio imageio-ffmpeg
    /sw/venv/bin/pip install --no-cache-dir --no-deps \
        "git+https://github.com/ucgmsim/visualisation.git@eee9f26102d5154a89593aa605f7be90433c9acb"

    # --- a generate-stoch that honours the requested dx/dy --------------------
    #
    # The base image's `workflow` carries the pegasus generate_stoch, which
    # shells out to the C `srf2stoch` binary and clamps the spacing to
    # min(stoch_dx, min_length/2) and min(stoch_dy, min_width/2). Both halves are
    # unusable for a resolution study: the binary cannot parse v2.0 SRFs at all,
    # and the clamp is driven by the *smallest* fault in the rupture — on event
    # 350269 a single 12.16 km fault caps dx at 6.079 km for the whole
    # 12,577 km2 rupture, so every requested spacing above that silently yields
    # the same stoch, with no error and a plausible-looking output.
    #
    # source_modelling FIRST, and pinned. convert_srf_to_stoch builds a StochFile
    # from a list of StochPlane — a constructor that arrived in 2026.7.3. Against
    # 2026.7.2 every call dies with
    #     TypeError: argument should be a str or an os.PathLike ... not 'list'
    # Pinned rather than inherited because the base image is the moving tag
    # `latest` and has shifted under us before (source-modelling 2026.6.6 in the
    # 14 Jul build, 2026.7.2 in the 24 Jul one), so "whatever the base ships" is
    # not a version. This is the one dependency the visualisation stack and the
    # stoch converter share, so it is also the one worth asserting in %test.
    /sw/venv/bin/pip install --no-cache-dir "source-modelling==2026.7.3"

    # Then workflow itself, over the copy the base image already installed.
    #
    # NEVER `pip install workflow` here: the name `workflow` on PyPI belongs to
    # an unrelated 2.x project, so that would quietly install someone else's
    # package and leave every entry point subtly wrong.
    #
    # --no-deps because the base image already supplies the whole stack and a
    # full resolve would reach the network for all of it (and could clobber the
    # pins above). --force-reinstall because workflow is already present, so pip
    # would otherwise call the requirement satisfied and change nothing.
    # SETUPTOOLS_SCM_PRETEND_VERSION because `git archive` strips .git and this
    # project takes its version from setuptools_scm, which without a repo cannot
    # compute one and fails the build.
    SETUPTOOLS_SCM_PRETEND_VERSION="$(cat /tmp/workflow-version.txt)" \
        /sw/venv/bin/pip install --no-cache-dir --no-deps --force-reinstall \
        /tmp/workflow-src.tar.gz
    rm -f /tmp/workflow-src.tar.gz /tmp/workflow-version.txt

    # Smoke-test here rather than in %test: this runs on a writable filesystem,
    # and importing source_modelling triggers numba's @njit(cache=True), which
    # wants to write a JIT cache. %test runs in the finished read-only image
    # where that write can fail for reasons that have nothing to do with the
    # install being correct, so %test checks files instead of importing.
    /sw/venv/bin/generate-stoch --help > /dev/null
    python -c "
import workflow.scripts.generate_stoch as g
assert hasattr(g, 'convert_srf_to_stoch'), 'clamped (pegasus) generate_stoch installed'
import importlib.metadata as m
print('generate-stoch OK: workflow', m.version('workflow'),
      '| source_modelling', m.version('source_modelling'))
"

    # Bake pygmt_helper's map/topo data into the image so plots work with no
    # internet on BSC compute nodes. pygmt_helper caches via
    # pooch.os_cache("pygmt_helper"), which honours XDG_CACHE_HOME -> we fix the
    # cache to an in-image path and export the same path in %environment, so the
    # baked data is found at runtime regardless of $HOME (works under `exec -c`).
    export XDG_CACHE_HOME=/opt/cache
    mkdir -p /opt/cache
    python - <<'PY'
from pygmt_helper import plotting
data = plotting.GMT_DATA
# Korea grids are irrelevant to NZ work; skip them to save ~100 MB.
skip = {
    "data/Topo/srtm_KR.grd", "data/Topo/srtm_KR_i5.grd",
    "data/Paths/water/KR.gmt", "data/Paths/highway/KR.gmt",
    "data/Paths/road/KR.gmt",
}
ok = failed = 0
for key in list(data.registry):
    if key in skip:
        continue
    try:
        data.fetch(key)
        ok += 1
    except Exception as exc:  # noqa: BLE001 - keep going, report at end
        failed += 1
        print(f"  SKIP {key}: {exc}")
print(f"pygmt_helper data baked: {ok} fetched, {failed} failed")
PY

    # Bake cartopy's Natural Earth vectors for the same reason, but note this is a
    # SEPARATE data system from the pooch cache above and neither covers the other.
    # plot_ts's --simple-map path draws LAND/OCEAN/COASTLINE/BORDERS/LAKES through
    # cfeature.*.with_scale(), and cartopy fetches each from naturalearth.s3 on
    # first use. Offline that is a stall then a crash -- and because cartopy
    # resolves geometries lazily it lands at savefig(), taking the render down
    # after all the compute is done rather than failing fast at add_feature().
    #
    # cartopy WRITES downloads to config['data_dir'] ($XDG_DATA_HOME/cartopy) but
    # RESOLVES reads from config['pre_existing_data_dir'] (CARTOPY_DATA_DIR) first.
    # Those are different settings, so point the writer at /opt for the build and
    # export the reader in %environment. Fixing an in-image path matters for the
    # same reason it does for pooch: data_dir otherwise defaults to
    # ~/.local/share/cartopy, i.e. the *caller's* home, which is absent under
    # `exec -c` and differs between BSC and a laptop.
    #
    # Both scales are baked (43 MB: 35 for 10m, 7 for 50m) so --scale stays usable;
    # 10m is the plot_ts default. Resolving .geometries() rather than merely
    # downloading is deliberate -- that lazy parse is the step that actually fails
    # in the field, so this proves the file is present AND readable.
    export XDG_DATA_HOME=/opt
    python - <<'PY'
import cartopy
import cartopy.feature as cfeature
baked = 0
for scale in ("10m", "50m"):
    for name in ("LAND", "OCEAN", "COASTLINE", "BORDERS", "LAKES"):
        n = len(list(getattr(cfeature, name).with_scale(scale).geometries()))
        print(f"  cartopy {name} {scale}: {n} geometries")
        baked += 1
print(f"cartopy natural_earth baked: {baked} datasets into {cartopy.config['data_dir']}")
PY

    # Pre-build matplotlib's font cache in the same dir so the read-only runtime
    # image does not try to write it on first plot.
    python -c "import matplotlib.pyplot" || true

    chmod -R a+rX /sw /opt/cache /opt/cartopy

%environment
    export PATH="/sw/venv/bin:/sw/cargo/bin:/sw/python/bin:$PATH"
    export VIRTUAL_ENV="/sw/venv"
    export LD_LIBRARY_PATH="/usr/local/lib:$LD_LIBRARY_PATH"
    # XDG_CACHE_HOME points pygmt_helper's pooch at the baked-in grids (read-only
    # reads are fine). But the image filesystem is read-only at runtime, so tools
    # that WRITE a cache must be redirected to a writable dir or they fail on
    # import: source_modelling uses numba @njit(cache=True) (writes JIT cache),
    # and matplotlib writes a font cache. Point both at per-user /tmp dirs
    # (evaluated at container start; honour any value the caller already set).
    export XDG_CACHE_HOME=/opt/cache
    # Where cartopy finds the baked Natural Earth vectors (see %post). Set
    # unconditionally, like XDG_CACHE_HOME above and unlike the two writable
    # caches below, because the whole point is that the image supplies this data
    # itself -- a caller who overrides it silently loses offline rendering.
    # Deliberately CARTOPY_DATA_DIR and not XDG_DATA_HOME: callers legitimately
    # set XDG_DATA_HOME (our BSC plotting jobs do), and that only moves cartopy's
    # download target, so pinning the read path here keeps the baked data winning
    # regardless of what the caller's environment does.
    export CARTOPY_DATA_DIR=/opt/cartopy
    export NUMBA_CACHE_DIR="${NUMBA_CACHE_DIR:-/tmp/numba-cache-$(id -u)}"
    export MPLCONFIGDIR="${MPLCONFIGDIR:-/tmp/mpl-cache-$(id -u)}"

%test
    # %test runs in the read-only built image. Anything that starts a GMT session
    # (import pygmt is fine, but the visualisation imports, `plot-* --help`,
    # show_versions, and savefig all begin a session) tries to create a session
    # dir and fails with "Read-only file system" here, even though it works fine
    # at runtime under `apptainer exec` (writable /tmp + $HOME). So this gate is
    # deliberately session-free; the authoritative figure/animation render is run
    # post-build with `apptainer exec` — see viz_container_build.md.
    set -e
    python -c "import ctypes; ctypes.CDLL('libgmt.so')"   # libgmt loads (symlink OK), no session
    python -c "import ffmpeg"                              # ffmpeg-python importable
    command -v gs                                          # ghostscript for pygmt psconvert
    command -v ffmpeg
    test -x /sw/venv/bin/plot-srf                          # visualisation entry points installed
    test -x /sw/venv/bin/plot-ts
    /sw/venv/bin/pip show visualisation >/dev/null
    # source_modelling must still be the pinned release, not a git-HEAD clobber.
    # 2026.7.3 is a floor as much as a pin: below it convert_srf_to_stoch cannot
    # construct a StochFile at all (see %post).
    python -c "import importlib.metadata as m; v=m.version('source_modelling'); assert v=='2026.7.3', v"
    # generate-stoch must be the pure-Python converter that honours the requested
    # dx/dy, not the clamped shell-out to the C binary. Asserted on the INSTALLED
    # FILE rather than by importing, because importing source_modelling wants to
    # write a numba JIT cache and this stage is read-only — a failure there would
    # look like a bad install when it is only a bad filesystem.
    #
    # Both directions are checked. The new symbol being present does not prove
    # the clamp is gone: a future merge could reintroduce the clamp alongside
    # convert_srf_to_stoch and satisfy only the first test.
    test -x /sw/venv/bin/generate-stoch
    GS=$(ls /sw/venv/lib/python*/site-packages/workflow/scripts/generate_stoch.py)
    grep -q "def convert_srf_to_stoch" "$GS"
    ! grep -q "min_length" "$GS"
    for g in srtm_NZ srtm_NZ_i5 srtm_NZ_1s srtm_NZ_1s_i5; do \
        test -f /opt/cache/pygmt_helper/data/Topo/$g.grd; done
    # Assert the cartopy vectors are present as FILES rather than asking the
    # cartopy API to resolve them. %test runs on the build host, which has
    # internet, so an API check would silently re-download anything missing and
    # pass -- masking exactly the failure this bake exists to prevent until the
    # job is already on an internet-less BSC node. BORDERS lives under cultural/
    # while the rest are physical/, which is easy to get wrong by hand.
    for s in 10m 50m; do \
        for f in land ocean coastline lakes; do \
            test -f /opt/cartopy/shapefiles/natural_earth/physical/ne_${s}_${f}.shp; done; \
        test -f /opt/cartopy/shapefiles/natural_earth/cultural/ne_${s}_admin_0_boundary_lines_land.shp; done
    echo "viz.sif build-time checks passed (render verified post-build via apptainer exec)"

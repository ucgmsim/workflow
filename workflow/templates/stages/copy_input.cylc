[[copy_input]]
    platform = localhost
    script = """
    set -eu pipefail

    mkdir -p "$CYLC_WORKFLOW_SHARE_DIR/event"

    for r in $(seq 1 {{realisations}}); do
        mkdir -p "$CYLC_WORKFLOW_SHARE_DIR/R$r"
    done

    rsync -a --ignore-existing "$CYLC_WORKFLOW_RUN_DIR/input/" "$CYLC_WORKFLOW_SHARE_DIR"
    """

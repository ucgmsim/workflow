[[root]]

{% if host_environment['root'].platform %}
    platform = {{host_environment['root'].platform}}
{% endif %}
{% if host_environment['root'].pre_script %}
    pre-script = """
        {{host_environment['root'].pre_script}}
    """
{% endif %}
{% if host_environment['root'].directives %}
    [[[directives]]]
{% for variable, value in host_environment['root'].directives.items() %}
         {{variable}} = {{value}}
{% endfor %}
{% endif %}

{% if host_environment['root'].environment %}
    [[[environment]]]
        EVENT_SHARE = "$CYLC_WORKFLOW_SHARE_DIR/event"
        TASK_SHARE = "$CYLC_WORKFLOW_SHARE_DIR/R1"
        APPTAINER_BINDPATH = "$PWD:/out,${TASK_SHARE}:/share,${EVENT_SHARE}:/event"
{% for variable, value in host_environment['root'].environment.items() %}
        {{variable}} = {{value}}
{% endfor %}
{% endif %}

{# deliberate blank line at end of root #}

{% macro stage_node_identifier(stage) -%}
{{stage.id}}<{{stage.parameters | join(", ")}}>
{%- endmacro -%}

[task parameters]
      event = {{ realisations | map(attribute=0) | join(", ") }}
      {% for event, realisation in realisations -%}
      {{event}}_realisations = 1..{{realisation}}
      {% endfor %}
[scheduling]
    [[graph]]
        R1 = """
        {{workflow_graph | indent(8, false)}}
        """
    {% include target_host + '/queue.cylc' %}
{% include target_host + '/root.cylc' %}
[[JOB<event, realisation>]]
     [[[environment]]]
          EVENT = %(event)s
          REALISATION = %(realisation)s
          TASK_SHARE = $CYLC_WORKFLOW_SHARE_DIR/share/%(event)s_%(realisation)s
          EVENT_SHARE = $CYLC_WORKFLOW_SHARE_DIR/share/%(event)s
          BIND = $PWD:/out:$TASK_SHARE:/share:$EVENT_SHARE:/event
{% for stage in stages %}
{% include target_host + '/' + stage.id + '.cylc' %}
{% endfor %}

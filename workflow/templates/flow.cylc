{% macro stage_node_identifier(stage) -%}
{{stage.id}}{% if stage.parameters %}<{{stage.parameters | join(", ")}}>{% endif %}
{%- endmacro -%}

[task parameters]
      realisation = 1..{{realisations}}

[scheduling]
    [[graph]]
        R1 = """
        {{workflow_graph | indent(8, false)}}
        """
    {% include 'stages/queue.cylc' %}
[runtime]
[[JOB<realisation>]]
     [[[environment]]]
          REALISATION = %(realisation)s
          TASK_SHARE = $CYLC_WORKFLOW_SHARE_DIR/R%(realisation)s
          APPTAINER_BINDPATH = "$PWD:/out,${TASK_SHARE}:/share,${EVENT_SHARE}:/event"
{% include 'stages/root.cylc' %}
{% for stage in stages %}
{% include 'stages/' + stage.id + '.cylc' %}
{% endfor %}

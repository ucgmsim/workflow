[[copy_input]]
        script = """
               mkdir -p {% for realisation in realisations %}{{ '$CYLC_WORKFLOW_SHARE_DIR/' ~ realisations[0] ~ '_' ~ realisations[1] }} {% endfor %}
               [[ ! -d $CYLC_WORKFLOW_RUN_DIR/input ]] || cp -rn $CYLC_WORKFLOW_RUN_DIR/input/. $CYLC_WORKFLOW_SHARE_DIR
        """

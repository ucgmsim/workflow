[[{{stage_node_identifier(stage)}}]]
        script = apptainer exec --bind "$PWD:/out,$CYLC_WORKFLOW_SHARE_DIR/{{realisation_identifier(stage)}}:/share,/mnt/hypo_scratch/ko_matrices:/ko_matrices" {{container}} im-calc /share/realisation.json /share/realisation.bb /share/intensity_measures.parquet --ko-directory /ko_matrices
        inherit = large_job

[[{{stage_node_identifier(stage)}}]]
        pre-script = module load foss/2023a
        script = srun {{emod3d_path}} -args "par=$CYLC_WORKFLOW_SHARE_DIR/{{realisation_identifier(stage)}}/LF/e3d.par"
        [[[directives]]]
                --partition = milan
                --ntasks = 160
                --mem-per-cpu = 2000MB
                --nodes = 2
                --time = 06:00:00

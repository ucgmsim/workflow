[[{{stage_node_identifier(stage)}}]]
        pre-script = module load foss/2023a
        script = srun "$EMOD3D" -args "par=$TASK_SHARE/LF/e3d.par"
        [[[directives]]]
                --ntasks = 160
                --mem-per-cpu = 2000MB
                --nodes = 2
                --time = 06:00:00
